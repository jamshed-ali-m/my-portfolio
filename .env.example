# Rename this file to .env.local and fill in real values before connecting a live backend.

# LLM provider key used ONLY by the server-side API routes (/app/api/chat, /app/api/estimate).
# NEVER expose this in client-side code. Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Contact form email delivery. Free key: https://resend.com/api-keys
RESEND_API_KEY=
CONTACT_EMAIL=hello@yourdomain.com
CONTACT_FROM=onboarding@resend.dev
